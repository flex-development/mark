{
  "name": "@flex-development/mark-util-symbol",
  "description": "mark symbol utility",
  "version": "3.1.0",
  "keywords": [
    "compile",
    "finite",
    "fsm",
    "lexer",
    "mark",
    "parse",
    "state",
    "symbol",
    "tokenize"
  ],
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/flex-development/mark/tree/main/packages/mark-util-symbol",
  "repository": {
    "directory": "packages/mark-util-symbol",
    "type": "git",
    "url": "git+https://github.com/flex-development/mark.git"
  },
  "bugs": "https://github.com/flex-development/mark/issues",
  "funding": [
    {
      "type": "GitHub Sponsors",
      "url": "https://github.com/sponsors/flex-development"
    }
  ],
  "author": {
    "name": "Lexus Drumgold",
    "url": "https://github.com/unicornware"
  },
  "publishConfig": {
    "access": "public",
    "diff-dst-prefix": "mark-util-symbol",
    "diff-src-prefix": "mark-util-symbol",
    "directory": "./",
    "executableFiles": [],
    "node-options": null,
    "pack-destination": ".",
    "parseable": true,
    "prefer-dedupe": true,
    "provenance": true,
    "tag-version-prefix": "mark-util-symbol@"
  },
  "type": "module",
  "files": [
    "LICENSE.md",
    "README.md",
    "dist"
  ],
  "exports": {
    ".": {
      "mark": "./src/index.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "devDependencies": {
    "micromark-util-symbol": "2.0.1"
  },
  "sideEffects": false
}
