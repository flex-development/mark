{
  "name": "@flex-development/mark-util-combine-extensions",
  "description": "mark utility to combine extensions",
  "version": "0.0.0",
  "keywords": [
    "mark",
    "extension",
    "tokenize",
    "typescript",
    "util",
    "utility"
  ],
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/flex-development/mark/tree/main/packages/flex-development/mark-util-combine-extensions",
  "repository": {
    "directory": "packages/mark-util-combine-extensions",
    "type": "git",
    "url": "git+https://github.com/flex-development/mark.git"
  },
  "bugs": "https://github.com/flex-development/mark/issues",
  "author": {
    "name": "Lexus Drumgold",
    "url": "https://github.com/unicornware"
  },
  "publishConfig": {
    "access": "public",
    "diff-dst-prefix": "mark-util-combine-extensions",
    "diff-src-prefix": "mark-util-combine-extensions",
    "directory": "./",
    "executableFiles": [],
    "node-options": null,
    "pack-destination": ".",
    "parseable": true,
    "prefer-dedupe": true,
    "provenance": true,
    "tag-version-prefix": "mark-util-combine-extensions@"
  },
  "type": "module",
  "files": [
    "LICENSE.md",
    "README.md",
    "dist"
  ],
  "exports": {
    ".": {
      "mark": "./src/index.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#fixtures/*": "./__fixtures__/*.mts"
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "dependencies": {
    "@flex-development/mark": "workspace:1.0.0-alpha.12",
    "@flex-development/mark-util-chunked": "workspace:1.0.0",
    "devlop": "1.1.0"
  },
  "devDependencies": {
    "@flex-development/mark-util-symbol": "workspace:*"
  },
  "sideEffects": false
}
