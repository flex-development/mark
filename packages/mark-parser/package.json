{
  "name": "@flex-development/mark-parser",
  "description": "finite state machine tokenizer",
  "version": "1.0.0-alpha.21",
  "keywords": [
    "fsm",
    "lexer",
    "parse",
    "state",
    "tokenize"
  ],
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/flex-development/mark/tree/main/packages/mark-parser",
  "repository": {
    "directory": "packages/mark-parser",
    "type": "git",
    "url": "git+https://github.com/flex-development/mark.git"
  },
  "bugs": "https://github.com/flex-development/mark/issues",
  "funding": [
    {
      "type": "GitHub Sponsors",
      "url": "https://github.com/sponsors/flex-development"
    }
  ],
  "author": {
    "name": "Lexus Drumgold",
    "url": "https://github.com/unicornware"
  },
  "publishConfig": {
    "access": "public",
    "diff-dst-prefix": "mark-parser",
    "diff-src-prefix": "mark-parser",
    "directory": "./",
    "executableFiles": [],
    "node-options": null,
    "pack-destination": ".",
    "parseable": true,
    "prefer-dedupe": true,
    "provenance": true,
    "tag-version-prefix": "mark-parser@"
  },
  "type": "module",
  "files": [
    "LICENSE.md",
    "README.md",
    "dist"
  ],
  "exports": {
    ".": {
      "mark": "./src/index.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#constructs/*": {
      "mark": "./src/constructs/*.mts",
      "default": "./dist/constructs/*.mjs"
    },
    "#fixtures/*": "./__fixtures__/*.mts",
    "#internal/*": {
      "mark": "./src/internal/*.mts",
      "default": "./dist/internal/*.mjs"
    },
    "#tests/*": "./__tests__/*.mts"
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "dependencies": {
    "@flex-development/mark": "workspace:1.0.0-alpha.13",
    "@flex-development/mark-util-character": "workspace:1.1.1",
    "@flex-development/mark-util-chunked": "workspace:1.1.1",
    "@flex-development/mark-util-combine-extensions": "workspace:1.0.0-alpha.1",
    "@flex-development/mark-util-decode": "workspace:1.0.0-alpha.1",
    "@flex-development/mark-util-resolve-all": "workspace:1.0.0-alpha.1",
    "@flex-development/mark-util-serialize": "workspace:1.0.0-alpha.1",
    "@flex-development/mark-util-symbol": "workspace:1.0.0-alpha.13",
    "@flex-development/unist-util-builder": "2.0.0",
    "@types/debug": "4.1.13",
    "debug": "4.4.3",
    "devlop": "1.1.0"
  },
  "devDependencies": {
    "micromark": "4.0.3",
    "micromark-core-commonmark": "2.0.4",
    "micromark-util-character": "2.1.1",
    "micromark-util-symbol": "2.0.1",
    "micromark-util-types": "2.0.3"
  },
  "sideEffects": false
}
