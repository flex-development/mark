{
  "name": "@flex-development/mark-factory-space",
  "description": "mark factory to parse whitespace",
  "version": "1.0.0-alpha.1",
  "keywords": [
    "mark",
    "factory",
    "space",
    "tokenize"
  ],
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/flex-development/mark/tree/main/packages/mark-factory-space",
  "repository": {
    "directory": "packages/mark-factory-space",
    "type": "git",
    "url": "git+https://github.com/flex-development/mark.git"
  },
  "bugs": "https://github.com/flex-development/mark/issues",
  "funding": [
    {
      "type": "GitHub Sponsors",
      "url": "https://github.com/sponsors/flex-development"
    }
  ],
  "author": {
    "name": "Lexus Drumgold",
    "url": "https://github.com/unicornware"
  },
  "publishConfig": {
    "access": "public",
    "diff-dst-prefix": "mark-factory-space",
    "diff-src-prefix": "mark-factory-space",
    "node-options": null,
    "pack-destination": ".",
    "parseable": true,
    "prefer-dedupe": true,
    "provenance": true,
    "tag-version-prefix": "mark-factory-space@"
  },
  "type": "module",
  "files": [
    "LICENSE.md",
    "README.md",
    "dist"
  ],
  "exports": {
    ".": {
      "mark": "./src/index.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "dependencies": {
    "@flex-development/mark": "workspace:1.0.0-alpha.14",
    "@flex-development/mark-util-character": "workspace:2.0.0-alpha.1"
  },
  "sideEffects": false
}
