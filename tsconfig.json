{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "alwaysStrict": true,
    "customConditions": ["mark", "development"],
    "declaration": true,
    "declarationMap": true,
    "lib": ["es2025", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "newLine": "lf",
    "noEmit": true,
    "noErrorTruncation": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": true,
    "sourceMap": true,
    "target": "esnext",
    "verbatimModuleSyntax": true
  },
  "exclude": ["coverage/", "examples/", "node_modules/", "packages/"],
  "extends": "@tsconfig/strictest/tsconfig",
  "include": ["**/*.mjs", "**/*.mts", "**/.*.mjs", "**/.*.mts"],
  "references": [
    {
      "path": "packages/mark-compiler/tsconfig.json"
    },
    {
      "path": "packages/mark-parser/tsconfig.json"
    },
    {
      "path": "examples/jack/tsconfig.json"
    },
    {
      "path": "examples/splat/tsconfig.json"
    }
  ]
}
