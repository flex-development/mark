{
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "allowJs": false,
    "checkJs": false,
    "customConditions": ["mark"],
    "declarationMap": false,
    "noEmitOnError": true,
    "rewriteRelativeImportExtensions": true,
    "sourceMap": false,
    "target": "es2025"
  },
  "exclude": ["**/__mocks__/**", "**/__tests__/**"],
  "extends": "./tsconfig.json",
  "files": [],
  "include": ["dist/**/*", "src/**/**.mts"],
  "references": [
    {
      "path": "packages/mark-compiler/tsconfig.build.json"
    },
    {
      "path": "packages/mark-parser/tsconfig.build.json"
    }
  ]
}
